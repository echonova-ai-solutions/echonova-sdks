{
  "name": "echonova-proxy-express",
  "version": "0.1.0",
  "private": true,
  "description": "Reference backend proxy for the EchoNova API (Express): keeps the API key on your server.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "undici": "^7.30.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
