{
  // Type-checks examples/ against the source: '@echonova/ai' and '@echonova/ai/streaming' map to src/,
  // so no build is needed. (At run time Node.js resolves them to this package's dist/.)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@echonova/ai": ["./src/index.ts"],
      "@echonova/ai/streaming": ["./src/streaming/index.ts"]
    }
  },
  "include": ["examples"]
}
